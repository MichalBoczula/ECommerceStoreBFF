    "/mobile-phones": {
      "get": {
        "tags": [
          "MobilePhones"
        ],
        "summary": "Get mobile phones",
        "description": "Returns up to the requested amount of active mobile phones ordered by name, then Id.",
        "operationId": "GetMobilePhones",
        "parameters": [
          {
            "name": "amount",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MobilePhoneDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
