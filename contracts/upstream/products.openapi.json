    "/mobile-phones/{id}": {
      "get": {
        "tags": [
          "MobilePhones"
        ],
        "summary": "Get mobile phone by Id",
        "description": "Returns the mobile phone details when the Id exists, including inactive phones; 404 otherwise.",
        "operationId": "GetMobilePhoneById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
