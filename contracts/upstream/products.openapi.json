  "paths": {
    "/products-documentation/flow": {
      "get": {
        "tags": [
          "Documentation"
        ],
        "summary": "Describe all request flows",
        "description": "Returns the ordered steps executed when handling every documented request.",
        "operationId": "DescribeAllFlows",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlowDescription"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/products-documentation/validation-policies": {
      "get": {
        "tags": [
          "Documentation"
        ],
        "summary": "Describe all validation policies",
        "description": "Returns validation policies with their rules and possible validation errors.",
