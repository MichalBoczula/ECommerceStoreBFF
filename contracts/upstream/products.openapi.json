          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "MobilePhones"
        ],
        "summary": "Create mobile phone",
        "description": "Creates a new mobile phone and returns the created resource.",
        "operationId": "CreateMobilePhone",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMobilePhoneExternalDto"
              }
