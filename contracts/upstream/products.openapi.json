              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/mobile-phones/top": {
      "get": {
        "tags": [
          "MobilePhones"
        ],
        "summary": "Get top mobile phones",
        "description": "Returns the three most recently changed active mobile phones, ordered by ChangedAt descending, then Id descending. Top means recent changes, not sales popularity.",
        "operationId": "GetTopMobilePhones",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TopMobilePhoneDto"
                  }
                }
              }
            }
          },
          "500": {
