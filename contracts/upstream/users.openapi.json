          "street"
        ],
        "type": "object",
        "properties": {
          "postalCode": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "buildingNumber": {
            "type": "string"
          },
          "apartmentNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AdminResponseDto": {
        "required": [
          "email",
          "externalId",
          "fullName",
          "id",
          "isActive",
          "lastLoginAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
