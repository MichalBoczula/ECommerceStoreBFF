        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "AddressRequestDto": {
        "required": [
          "apartmentNumber",
          "buildingNumber",
          "city",
          "postalCode",
          "street"
        ],
        "type": "object",
        "properties": {
          "postalCode": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "buildingNumber": {
            "type": "string"
          },
          "apartmentNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AddressResponseDto": {
