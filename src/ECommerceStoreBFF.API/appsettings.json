{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug"
    }
  },
  "AllowedHosts": "*",
  "GatewaySettings": {
    "BaseUrl": "http://localhost:3000"
  },
  "ReverseProxy": {
    "Routes": {
      "products-swagger-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/products/swagger/v1/swagger.json"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/products"
          }
        ]
      },
      "users-swagger-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/users/swagger/v1/swagger.json"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/users"
          }
        ]
      },
      "orders-swagger-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/orders/swagger/v1/swagger.json"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/orders"
          }
        ]
      },
      "payments-openapi-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/payments/openapi.json"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/payments"
          }
        ]
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "CorsPolicy": "AngularCorsPolicy",
        "Match": {
          "Path": "/{**catchall:regex(products-documentation|mobile-phones|categories|currencies)}"
        }
      },
      "users-route": {
        "ClusterId": "users-cluster",
        "CorsPolicy": "AngularCorsPolicy",
        "Match": {
          "Path": "/{**catchall:regex(users-documentation|users|customers|admins|favorites)}"
        }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "CorsPolicy": "AngularCorsPolicy",
        "Match": {
          "Path": "/{**catchall:regex(orders-documentation|orders|shopping-carts|invoices|client-data-versions)}"
        }
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "CorsPolicy": "AngularCorsPolicy",
        "Match": {
          "Path": "/{**catchall:regex(payments)}"
        }
      }
    },
    "Clusters": {
      "products-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5000"
          }
        }
      },
      "users-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:6500"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7000"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8000"
          }
        }
      }
    }
  }
}
